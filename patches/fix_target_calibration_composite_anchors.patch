+def _alignment_anchor_mask(values: Sequence[object] | np.ndarray, anchor: object) -> np.ndarray:
+    """Return an equality mask for scalar and composite alignment anchors.
+
+    Target-calibration splits may use composite metadata anchors, e.g. tuple-like
+    ``(run, stimulus)`` values.  ``numpy_object_array == tuple`` broadcasts the
+    tuple fields instead of treating the tuple as one atomic anchor, which can
+    raise a ``ValueError`` or silently select incorrect rows.  Compare row by row
+    and coerce scalar equality results to bool.
+    """
+
+    vector = np.asarray(values, dtype=object).reshape(-1)
+    mask = np.zeros(vector.shape[0], dtype=bool)
+    for index, value in enumerate(vector):
+        try:
+            equal = value == anchor
+        except (TypeError, ValueError):
+            equal = False
+        try:
+            mask[index] = bool(equal)
+        except (TypeError, ValueError):
+            mask[index] = False
+    return mask
+
+
